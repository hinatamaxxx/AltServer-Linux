#!/bin/sh
set -eu

. "${ENV_FILE:-/etc/altserver-native.env}"

image="${ICLOUD_ANISETTE_IMAGE:?ICLOUD_ANISETTE_IMAGE is not configured}"
state="${ICLOUD_ANISETTE_STATE_DIR:-/var/lib/altserver-native/icloud-local}"
apple="${ICLOUD_ANISETTE_APPLE_DIR:-/opt/altserver-native/icloud-local/apple}"

if [ ! -f "$apple/AppleIncRootCertificate.cer" ]; then
  echo "Apple runtime missing; run: sudo sh install.sh --import-apple-runtime <archive>" >&2
  exit 1
fi
# The Wine prefix holds the provisioned identity Apple trusts; never recreate it here.
install -d -m 0700 "$state"
/usr/bin/docker rm -f altserver-icloud-local >/dev/null 2>&1 || true
exec /usr/bin/docker run --rm --name altserver-icloud-local --hostname altserver-icloud \
  --memory 512m --memory-swap 768m --cap-drop ALL --security-opt no-new-privileges \
  -p 127.0.0.1:6972:6969 -v "$state:/state" -v "$apple:/apple:ro" "$image"
