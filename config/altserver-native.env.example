# Reference only. install.sh --configure generates the real file with mode 0600.
# 参考用です。実際の設定は install.sh --configure が権限 0600 で生成します。
ALTSERVER_HOST_IP='<DEBIAN_LAN_IP>'
IPHONE_UDID='<IPHONE_UDID>'
IPHONE_WIFI_MAC='<IPHONE_WIFI_MAC>'
IPHONE_FALLBACK_IP=''
ALTSERVER_HOME=/opt/altserver-native
ALTSERVER_BIN=/opt/altserver-native/bin/AltServer
NETMUXD_BIN=/opt/altserver-native/bin/netmuxd
USBMUXD_SOCKET_ADDRESS=127.0.0.1:27015
NETMUXD_REGISTER_MODE=api
ALTSERVER_NO_SUBSCRIBE=1
ALTSERVER_ANISETTE_SERVER=http://127.0.0.1:6969
ANISETTE_URL=http://127.0.0.1:6969/
ANISETTE_DOCKER_IMAGE='dadoum/anisette-v3-server@sha256:<PREPARED_IMAGE_DIGEST>'
ANISETTE_STATE_DIR=/var/lib/altserver-native/anisette
