# Existing upstream toolchain includes corecrypto, cpprestsdk and static libraries.
# The source and all submodules come from this checkout, not a release binary.
FROM ghcr.io/nyamisty/altserver_builder_alpine_amd64@sha256:b96e411d23a2c8472942990b72fb902f7f08ce290889d40e46ce80ccb1b77dd7 AS build
WORKDIR /workdir
COPY . .
RUN test -f upstream_repo/AltServer/AltServerApp.cpp \
    && mkdir -p build \
    && cd build \
    && make -f ../Makefile -j2
RUN apk add --no-cache openssl \
    && clang++ tests/ldid_main.cpp build/objs/ldid_patched/ldid.cpp.o \
      build/objs/ldid_patched/lookup2.c.o build/libplist.a \
      -lssl -lcrypto -lz -o /tmp/test-ldid \
    && python3 tools/check-build.py

FROM scratch AS export
COPY --from=build /workdir/build/AltServer-x86_64 /AltServer-x86_64
